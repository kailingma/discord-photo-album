# Private environment variables. Never commit filled values.
DISCORD_TOKEN=
BRIDGE_TOKEN=
ALBUM_URL=http://localhost:8080
PUBLIC_URL=https://your-photo-host.example
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Hack Club optional; raw CDN URLs are PUBLIC, permanent external storage.
ARCHIVE_STORAGE=private
HACKCLUB_CDN_KEY=
HACKCLUB_PUBLIC_PHOTOS=no
# Standalone server can reuse private R2 instead of local blobs:
LOCAL_STORAGE=local
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ARCHIVE_MAX_BYTES=8000000000
ARCHIVE_MAX_OBJECTS=25000
